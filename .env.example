# Copy to .env locally. Do not commit real credentials.
# Current D072 native MySQL/Redis settings; real credentials stay local.
# No database is created by this file. Existing native credentials are preserved.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=shiji_dev
MYSQL_USERNAME=shiji_app
MYSQL_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=shiji:

# Future application port conventions; no application has been created yet.
BACKEND_PORT=8080
FRONTEND_PORT=5173
